{
  "expo": {
    "name": "Viajero Conectado",
    "slug": "viajero-conectado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viajeroconectado.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para que puedas capturar tus momentos de viaje",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para que puedas compartir tus recuerdos",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte experiencias cercanas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.viajeroconectado.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a $(PRODUCT_NAME) acceder a tu cámara"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a $(PRODUCT_NAME) acceder a tus fotos"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a $(PRODUCT_NAME) usar tu ubicación"
        }
      ]
    ],
    "scheme": "viajeroconectado",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
