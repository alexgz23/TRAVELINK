# Viajero Conectado - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# GENERAL
# ===========================================
NODE_ENV=development
VERSION=1.0.0

# ===========================================
# POSTGRESQL
# ===========================================
POSTGRES_DB=viajero_conectado
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ===========================================
# MONGODB
# ===========================================
MONGO_USER=admin
MONGO_PASSWORD=your_mongo_password_here
MONGO_DB=viajero_conectado_chat

# ===========================================
# REDIS
# ===========================================
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# JWT SECRETS
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# AWS
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=viajero-conectado-uploads

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===========================================
# PAYMENTS (WOMPI)
# ===========================================
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# MAPS
# ===========================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ===========================================
# ANALYTICS (OPTIONAL)
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# MONITORING (OPTIONAL)
# ===========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# ===========================================
# SEARCH
# ===========================================
TYPESENSE_API_KEY=dev_api_key_change_in_production
ELASTICSEARCH_URL=http://elasticsearch:9200

# ===========================================
# DEPLOYMENT
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,https://viajeroconectado.com

# ===========================================
# SECURITY
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
