# IMPORTANT: This is an example file. DO NOT commit actual secrets to git!
# Use kubectl create secret or a secrets management tool like:
# - Sealed Secrets
# - External Secrets Operator
# - HashiCorp Vault
# - AWS Secrets Manager
# - Google Secret Manager

apiVersion: v1
kind: Secret
metadata:
  name: viajero-secrets
  namespace: viajero-conectado
type: Opaque
stringData:
  # Database
  POSTGRES_PASSWORD: "changeme-postgres-password"
  DB_USERNAME: "postgres"
  DB_PASSWORD: "changeme-db-password"

  # Redis
  REDIS_PASSWORD: "changeme-redis-password"

  # MongoDB
  MONGO_USER: "admin"
  MONGO_PASSWORD: "changeme-mongo-password"

  # JWT
  JWT_SECRET: "changeme-jwt-secret-key-min-32-chars"
  JWT_REFRESH_SECRET: "changeme-refresh-secret-key-min-32-chars"

  # AWS
  AWS_ACCESS_KEY_ID: "your-aws-access-key"
  AWS_SECRET_ACCESS_KEY: "your-aws-secret-key"
  AWS_S3_BUCKET: "viajero-conectado-uploads"

  # Email
  SMTP_HOST: "smtp.gmail.com"
  SMTP_USER: "your-email@gmail.com"
  SMTP_PASS: "your-app-password"

  # Payment (Wompi)
  WOMPI_PUBLIC_KEY: "your-wompi-public-key"
  WOMPI_PRIVATE_KEY: "your-wompi-private-key"
  WOMPI_EVENTS_SECRET: "your-wompi-events-secret"

  # Monitoring
  SENTRY_DSN: "your-sentry-dsn"

  # Map
  NEXT_PUBLIC_MAPBOX_TOKEN: "your-mapbox-token"

  # Analytics
  NEXT_PUBLIC_GA_MEASUREMENT_ID: "G-XXXXXXXXXX"
